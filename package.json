{
  "name": "frontier-courses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "前沿课程：发现全球前沿课程与开源学习项目",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "collect": "node --env-file-if-exists=.env scripts/collect.js",
    "digest": "node --env-file-if-exists=.env server/digest.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.45.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "vite": "^8.3.0"
  }
}
