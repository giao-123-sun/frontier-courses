# 此文件只放占位说明。复制为 .env，真实密钥不要提交。
PORT=3001
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:3001
DATABASE_PATH=private/subscribers.db
TRUST_PROXY=0
SCHEDULER_ENABLED=true

# 配置完整后才开放邮件订阅。建议使用已验证域名的事务邮件服务。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 兼容聊天补全协议的模型服务。基础地址一般以 /v1 结尾。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 可选：提升开源仓库采集的接口额度。
GITHUB_TOKEN=
